# ============================================================
# NEXUS AI Backend — environment configuration
# Copy to backend/.env and fill in. NEVER commit real secrets.
# All values below are defaults suitable for local deployment.
# ============================================================

# --- Security ---
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be >= 32 bytes for JWT HS256.
NEXUS_SECRET_KEY=nexus-local-dev-only-change-me-0123456789abcdef
NEXUS_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Listening ---
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8080

# --- Air-gap / network guard ---
# When true, the backend refuses any outbound network request from
# tools (RAG, OCR, model gateway). Local loopback only.
NEXUS_AIR_GAP=true

# --- Local model gateway (Ollama) ---
# Leave empty to auto-detect http://127.0.0.1:11434
NEXUS_OLLAMA_BASE=http://127.0.0.1:11434
NEXUS_OLLAMA_TIMEOUT=300

# --- Embedded model for RAG (served by the local Ollama) ---
NEXUS_EMBED_MODEL=bge-m3

# --- Storage roots ---
NEXUS_UPLOAD_DIR=./data/uploads
NEXUS_DELIVERABLE_DIR=./data/deliverables
NEXUS_KB_DIR=./data/kb
NEXUS_VECTOR_DIR=./data/vector
NEXUS_AUDIT_DIR=./data/audit

# --- Sandbox ---
# powertools used by the sandbox to restrict a subprocess.
NEXUS_SANDBOX_USER=nobody

# --- Bootstrap admin (created on first run if DB empty) ---
# Never use the default in production.
NEXUS_ADMIN_USER=admin
NEXUS_ADMIN_PASSWORD=admin
NEXUS_ADMIN_EMAIL=admin@local
